	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="baris" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F2F2F2"/>
		</conditionalStyle>
	</style>
	<parameter name="LOGO_KANTOR" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kantor.png").getImage()]]></defaultValueExpression></parameter>
	<parameter name="LOGO_KAMPUS" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kampus.png").getImage()]]></defaultValueExpression></parameter>
	<queryString>
		<![CDATA[SELECT
     hasil.idhasil AS idhasil,
     hasil.idpngsn AS idpngsn,
     COALESCE(NULLIF(hasil.nmpmhn,''), penugasan.nmpmhn) AS nmpmhn,
     COALESCE(NULLIF(hasil.jns,''), penugasan.jns) AS jns,
     COALESCE(NULLIF(hasil.kec,''), penugasan.kec) AS kec,
     COALESCE(NULLIF(hasil.kel,''), penugasan.kel) AS kel,
     COALESCE(NULLIF(hasil.vlm,''), penugasan.vlm) AS vlm,
     COALESCE(NULLIF(hasil.haktanah,''), penugasan.haktanah) AS haktanah,
     COALESCE(NULLIF(hasil.nmptgs,''), penugasan.nmptgs) AS nmptgs,
     STR_TO_DATE(hasil.tggl, '%Y-%m-%d') AS tggl,
     hasil.progres AS progres,
     hasil.hslukur AS hslukur
FROM
     hasil LEFT JOIN penugasan ON hasil.idpngsn = penugasan.idpngsn
ORDER BY
     hasil.tggl, hasil.idhasil]]>
	</queryString>
	<field name="idhasil" class="java.lang.String"/>
	<field name="idpngsn" class="java.lang.String"/>
	<field name="nmpmhn" class="java.lang.String"/>
	<field name="jns" class="java.lang.String"/>
	<field name="kec" class="java.lang.String"/>
	<field name="kel" class="java.lang.String"/>
	<field name="vlm" class="java.lang.String"/>
	<field name="haktanah" class="java.lang.String"/>
	<field name="nmptgs" class="java.lang.String"/>
	<field name="tggl" class="java.sql.Date"/>
	<field name="progres" class="java.lang.String"/>
	<field name="hslukur" class="java.lang.String"/>
	<variable name="jml_belum" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[($F{progres} == "Belum Ukur") ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
	<variable name="jml_proses" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[($F{progres} == "Proses Ukur") ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
	<variable name="jml_selesai" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[($F{progres} == "Selesai Ukur") ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>

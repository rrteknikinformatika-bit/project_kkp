	<parameter name="LOGO_KANTOR" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kantor.png").getImage()]]></defaultValueExpression></parameter>
	<parameter name="LOGO_KAMPUS" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kampus.png").getImage()]]></defaultValueExpression></parameter>
	<queryString>
		<![CDATA[SELECT
     permohonan.idprmhnn AS idprmhnn,
     permohonan.tggl AS tggl,
     permohonan.jns AS jns,
     COALESCE(NULLIF(permohonan.nmpmhn,''), pemohon.nmpmhn) AS nmpmhn,
     COALESCE(NULLIF(permohonan.alm,''), pemohon.alm) AS alm,
     COALESCE(NULLIF(permohonan.notelp,''), pemohon.notlp) AS notelp,
     COALESCE(NULLIF(permohonan.kec,''), tanah.kec) AS kec,
     COALESCE(NULLIF(permohonan.kel,''), tanah.kel) AS kel,
     COALESCE(NULLIF(permohonan.vlm,''), tanah.vlm) AS vlm,
     COALESCE(NULLIF(permohonan.haktanah,''), tanah.haktanah) AS haktanah
FROM
     permohonan LEFT JOIN pemohon ON permohonan.idpmhn = pemohon.idpmhn
     LEFT JOIN tanah ON permohonan.idtnh = tanah.idtnh
ORDER BY
     permohonan.tggl, permohonan.idprmhnn]]>
	</queryString>
	<field name="idprmhnn" class="java.lang.String"/>
	<field name="tggl" class="java.sql.Date"/>
	<field name="jns" class="java.lang.String"/>
	<field name="nmpmhn" class="java.lang.String"/>
	<field name="alm" class="java.lang.String"/>

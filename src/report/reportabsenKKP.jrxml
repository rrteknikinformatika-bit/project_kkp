	<parameter name="LOGO_KANTOR" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kantor.png").getImage()]]></defaultValueExpression></parameter>
	<parameter name="LOGO_KAMPUS" class="java.awt.Image" isForPrompting="false"><defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kampus.png").getImage()]]></defaultValueExpression></parameter>
	<queryString>
		<![CDATA[SELECT
     absen_admin.id_absen AS id_absen,
     absen_admin.kd_admin AS kd_admin,
     admin.nm_admin AS nm_admin,
     absen_admin.tgl AS tgl,
     absen_admin.kehadiran AS kehadiran,
     absen_admin.keterangan AS keterangan
FROM
     absen_admin INNER JOIN admin ON absen_admin.kd_admin = admin.kd_admin
ORDER BY
     absen_admin.tgl, absen_admin.id_absen]]>
	</queryString>
	<field name="id_absen" class="java.lang.Integer"/>
	<field name="kd_admin" class="java.lang.String"/>
	<field name="nm_admin" class="java.lang.String"/>
	<field name="tgl" class="java.sql.Date"/>
	<field name="kehadiran" class="java.lang.String"/>
	<field name="keterangan" class="java.lang.String"/>
	<variable name="jml_hadir" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[($F{kehadiran} == "Hadir") ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>
	<variable name="jml_tidak" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[($F{kehadiran} == "Tidak Hadir") ? 1 : 0]]></variableExpression><initialValueExpression><![CDATA[0]]></initialValueExpression></variable>

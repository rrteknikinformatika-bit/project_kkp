	<parameter name="LOGO_KAMPUS" class="java.awt.Image" isForPrompting="false">
		<defaultValueExpression><![CDATA[new javax.swing.ImageIcon("C:/Hannu/KKP/logo/logo_kampus.png").getImage()]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     penugasan.nmpmhn AS penugasan_nmpmhn,
     penugasan.jns AS penugasan_jns,
     penugasan.kec AS penugasan_kec,
     penugasan.kel AS penugasan_kel,
     penugasan.vlm AS penugasan_vlm,
     jadwal.tggl AS jadwal_tggl,
     tugas.nmptgs AS tugas_nmptgs,
     tugas.nip AS tugas_nip
FROM
     penugasan INNER JOIN jadwal ON penugasan.idjdwl = jadwal.idjdwl
     INNER JOIN tugas ON penugasan.idptgs = tugas.idptgs
WHERE
     penugasan.idpngsn = $P{idpngsn}]]>
	</queryString>
